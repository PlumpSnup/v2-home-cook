# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used for share links and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers → API keys). Leave blank to launch with cash / e-transfer only.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional platform fee taken from card orders, in percent (0 = none)
PLATFORM_FEE_PERCENT=0

# Time zone used for "today / this week / this month" in the sales dashboard
NEXT_PUBLIC_TIMEZONE=America/Toronto
