# Database — added automatically when you connect a Neon database in Vercel → Storage
DATABASE_URL=postgres://user:password@host/dbname

# Login (Auth.js). AUTH_SECRET is any long random text, e.g. from https://generate-secret.vercel.app/32
AUTH_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dish photos — added automatically when you connect a Blob store in Vercel → Storage
BLOB_READ_WRITE_TOKEN=

# Public URL of the site (used for share links and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers → API keys). Leave blank to launch with cash / e-transfer only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional platform fee taken from card orders, in percent (0 = none)
PLATFORM_FEE_PERCENT=0

# Time zone used for "today / this week / this month" in the sales dashboard
NEXT_PUBLIC_TIMEZONE=America/Toronto
